POSTGRES_DB=moveinmate_prod
POSTGRES_USER=moveinmate
POSTGRES_PASSWORD=

SETTINGS_SOURCE=env
SETTINGS_ENCRYPTION_KEY=
LOGIN_RESET_ENABLED=false

APP_ENV=production
AUTH_MODE=required
AUTH_PROVIDER=local
ALLOW_DEMO_AUTH=false
ALLOW_DEMO_RESET=false
SHOW_LOCAL_LOGIN_CREDENTIALS=false
INCLUDE_DEMO_KNOWLEDGE=false
AUTH_JWT_SECRET=
AUTH_JWT_ISSUER=moveinmate-local
AUTH_JWT_AUDIENCE=moveinmate
AUTH_SESSION_TTL_SECONDS=28800
LOCAL_AUTH_ADMIN_USERNAME=admin
LOCAL_AUTH_ADMIN_PASSWORD=
LOCAL_AUTH_USER_USERNAME=user
LOCAL_AUTH_USER_PASSWORD=
LOCAL_AUTH_SITE_ID=sunrise-residence
LOCAL_AUTH_ADMIN_SITE_IDS=vinhomes-ocean-park,vinhomes-smart-city,vinhomes-grand-park
LOCAL_AUTH_USER_RESIDENT_ID=R001

ALLOWED_ORIGINS=https://moveinmate.example.com
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT_SECONDS=30
DB_CONNECT_TIMEOUT_SECONDS=10
LOG_LEVEL=INFO

LLM_PROVIDER=custom
LLM_MODEL=gpt-5.6-luna
LLM_BASE_URL=
LLM_API_KEY=
GEMINI_TTS_API_KEY=
OMICX_API_KEY=
LANGCHAIN_TRACING_V2=false
LANGSMITH_TRACING=false
